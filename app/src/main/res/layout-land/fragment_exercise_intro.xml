<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: lesson details and the full bar of tab on the start side; tempo and the
     Home/Play actions in a fixed-width column on the end side. The tab side scrolls on
     screens too short to fit it; the actions stay put. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".ExerciseIntroFragment">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_app_bar_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <!-- Lesson and tablature -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lesson_sixteenth"
                    android:textSize="26sp" />

                <!-- Technique, meter and best result; wraps onto two lines when narrow -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="exercise_technique,exercise_meta,best_result"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="8dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_verticalAlign="center"
                        app:flow_verticalGap="6dp"
                        app:flow_wrapMode="chain"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/exercise_technique"
                        style="@style/Chip.Tag"
                        android:text="@string/technique_alternate_picking" />

                    <TextView
                        android:id="@+id/exercise_meta"
                        style="@style/Chip.Neutral"
                        android:text="@string/exercise_meta" />

                    <LinearLayout
                        android:id="@+id/best_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/best_star"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            tools:src="@drawable/ic_star_bronze" />

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/your_best"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/best_tier"
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Bronze"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Tab card: fills the rest of the column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.TitleMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tab" />

                        <TextView
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="@string/downstroke"
                            app:drawableStartCompat="@drawable/ic_pick_down" />

                        <TextView
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="@string/upstroke"
                            app:drawableStartCompat="@drawable/ic_pick_up" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="4dp" />

                    <!-- All four beats on one staff, scaled to the card's width -->
                    <com.example.rythemia.TabStaffView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_staff_small"
                        android:paddingStart="9dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="10dp"
                        app:staffLayout="singleRow"
                        app:staffMode="intro" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="4dp" />

                    <TextView
                        style="@style/Text.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exercise_description"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Tempo and playback -->
        <LinearLayout
            android:layout_width="224dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <!-- Tempo card: fills the column above the actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="13dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.TitleMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tempo" />

                        <TextView
                            android:id="@+id/top_speed"
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Top speed: 120 BPM" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/slower_button"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_step_button"
                            android:contentDescription="@string/slower"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:scaleType="center"
                            android:src="@drawable/ic_minus" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_bpm_ring_small"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="4.452dp">

                            <TextView
                                android:id="@+id/bpm_value"
                                style="@style/Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sora_semibold"
                                android:letterSpacing="-0.03"
                                tools:text="120"
                                android:textSize="29.677sp" />

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/bpm"
                                android:textSize="8.161sp" />
                        </LinearLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/faster_button"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_step_button"
                            android:contentDescription="@string/faster"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:scaleType="center"
                            android:src="@drawable/ic_plus" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="4dp" />

                    <TextView
                        android:id="@+id/tempo_marking"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_semibold"
                        android:letterSpacing="-0.01"
                        tools:text="Allegro"
                        android:textColor="@color/accent_primary_text"
                        android:textSize="17sp" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="4dp" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/beat_dots" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_button"
                    style="@style/Widget.Rhythmia.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/home"
                    app:icon="@drawable/ic_home" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play_button"
                    style="@style/Widget.Rhythmia.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/play"
                    app:icon="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
