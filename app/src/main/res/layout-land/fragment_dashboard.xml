<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: greeting and progress across the top; below, the tracks and lessons lists pick
     the lesson shown in the card beside them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    tools:context=".DashboardFragment">

    <include
        android:id="@+id/app_bar"
        layout="@layout/view_app_bar_home" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <!-- Greeting and progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="314"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Text.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/dashboard_subtitle" />
                </LinearLayout>

                <!-- Progress card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="476"
                    android:background="@drawable/bg_tile"
                    android:orientation="vertical"
                    android:paddingStart="15dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="12dp">

                    <!-- Rank and stars share the width 232:188, as in the design -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="232"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_badge_pink">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_medal" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.LabelSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rank" />

                                <!-- Wraps after the hyphen, not mid-word, on narrow screens -->
                                <TextView
                                    style="@style/Text.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/rank_value_wrapping" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="26dp"
                            android:layout_weight="188"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Text.LabelSmall"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/stars_earned" />

                                <TextView
                                    style="@style/Text.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stars_value" />

                                <TextView
                                    style="@style/Text.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stars_total"
                                    android:textColor="@color/text_muted" />
                            </LinearLayout>

                            <!-- 6 of 27 stars -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="7dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_progress_track"
                                android:orientation="horizontal"
                                android:weightSum="27">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="6"
                                    android:background="@drawable/bg_progress_fill" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Star tiers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/tier_bronze_count"
                            android:textColor="@color/text_secondary"
                            app:drawableStartCompat="@drawable/ic_star_bronze_small" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/tier_silver_count"
                            android:textColor="@color/text_secondary"
                            app:drawableStartCompat="@drawable/ic_star_silver_small" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Text.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/tier_gold_count"
                            android:textColor="@color/text_secondary"
                            app:drawableStartCompat="@drawable/ic_star_gold_small" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tracks, lessons and the selected lesson. The card stretches to the row, which is
                 at least the card's 198dp design height (the lists are a little shorter). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:minHeight="198dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="248"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rhythm_tracks" />

                    <include
                        android:id="@+id/track_beginner"
                        layout="@layout/view_track_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <include
                        android:id="@+id/track_intermediate"
                        layout="@layout/view_track_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <include
                        android:id="@+id/track_advanced"
                        layout="@layout/view_track_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Lessons in the selected (Beginner) track -->
                <LinearLayout
                    android:id="@+id/beginner_lessons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="198"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lessons" />

                    <include
                        android:id="@+id/lesson_quarter"
                        layout="@layout/view_lesson_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <include
                        android:id="@+id/lesson_eighth"
                        layout="@layout/view_lesson_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <include
                        android:id="@+id/lesson_sixteenth"
                        layout="@layout/view_lesson_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <include
                    android:id="@+id/lesson_card"
                    layout="@layout/view_lesson_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="334" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
