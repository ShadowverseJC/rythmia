<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the body of the selected-lesson card, with the actions pinned to its bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/technique"
        style="@style/Chip.Tag" />

    <TextView
        android:id="@+id/summary"
        style="@style/Text.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="12dp" />

    <!-- Label size and spacing tighten on narrow screens (see dimens.xml) so nothing is cut off -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bookmark_button"
            style="@style/Widget.Rhythmia.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="151"
            android:paddingStart="@dimen/lesson_card_action_padding"
            android:paddingEnd="@dimen/lesson_card_action_padding"
            android:text="@string/bookmark"
            android:textSize="@dimen/lesson_card_action_text_size"
            app:iconPadding="@dimen/lesson_card_action_icon_padding"
            app:icon="@drawable/ic_bookmark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play_button"
            style="@style/Widget.Rhythmia.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="143"
            android:paddingStart="@dimen/lesson_card_action_padding"
            android:paddingEnd="@dimen/lesson_card_action_padding"
            android:text="@string/play"
            android:textSize="@dimen/lesson_card_action_text_size"
            app:iconPadding="@dimen/lesson_card_action_icon_padding"
            app:icon="@drawable/ic_play" />
    </LinearLayout>
</LinearLayout>
