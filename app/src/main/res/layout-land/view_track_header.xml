<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: a compact row in the Rhythm tracks list. The active track is marked selected;
     tracks don't expand here, so there is no chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_row"
    android:gravity="center_vertical"
    android:minHeight="51dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="3dp"
    android:paddingEnd="8dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/level"
        style="@style/Text"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_level_small"
        android:fontFamily="@font/sora_semibold"
        android:gravity="center"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Text.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/meta"
            style="@style/Text.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
