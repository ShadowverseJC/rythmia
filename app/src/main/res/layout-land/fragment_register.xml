<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: brand panel on the start side, sign-up card centered in the rest.
     The form fits without scrolling on screens down to 360dp tall (see the auth_*
     dimens); the scroll view is only a fallback for larger font sizes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".RegisterFragment">

    <!-- Brand -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="336"
        android:background="@drawable/bg_brand_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="19dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_large" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wordmark" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/register_tagline" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/rhythm_motif" />
    </LinearLayout>

    <!-- Account access -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="508"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="31dp"
            android:paddingTop="8dp"
            android:paddingEnd="31dp"
            android:paddingBottom="8dp">

            <!-- Sign up card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="@dimen/auth_card_padding_vertical"
                android:paddingEnd="20dp"
                android:paddingBottom="@dimen/auth_card_padding_vertical">

                <TextView
                    style="@style/Text.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/register_title" />

                <TextView
                    style="@style/Text.BodySmall.AuthSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/register_subtitle" />

                <!-- Username and email side by side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/username"
                            android:text="@string/field_username" />

                        <EditText
                            android:id="@+id/username"
                            style="@style/Widget.Rhythmia.Input"
                            android:layout_height="@dimen/auth_input_height"
                            android:layout_marginTop="4dp"
                            android:autofillHints="username"
                            android:hint="@string/hint_username"
                            android:inputType="text" />

                        <TextView
                            android:id="@+id/username_error"
                            style="@style/Text.FieldError" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/email"
                            android:text="@string/field_email" />

                        <EditText
                            android:id="@+id/email"
                            style="@style/Widget.Rhythmia.Input"
                            android:layout_height="@dimen/auth_input_height"
                            android:layout_marginTop="4dp"
                            android:autofillHints="emailAddress"
                            android:hint="@string/hint_email"
                            android:inputType="textEmailAddress" />

                        <TextView
                            android:id="@+id/email_error"
                            style="@style/Text.FieldError" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:labelFor="@id/password"
                    android:text="@string/field_password" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/password"
                        style="@style/Widget.Rhythmia.Input"
                        android:layout_height="@dimen/auth_input_height"
                        android:autofillHints="newPassword"
                        android:hint="@string/hint_create_password"
                        android:inputType="textPassword"
                        android:paddingEnd="56dp" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/show_password"
                        android:scaleType="center"
                        android:src="@drawable/ic_eye" />
                </FrameLayout>

                <TextView
                    android:id="@+id/password_error"
                    style="@style/Text.FieldError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_account_button"
                    style="@style/Widget.Rhythmia.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:text="@string/register_button" />
            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_footer_gap"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_footer_prompt" />

                <TextView
                    android:id="@+id/login_link"
                    style="@style/Text.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/geist_semibold"
                    android:padding="4dp"
                    android:text="@string/register_footer_link"
                    android:textColor="@color/accent_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
