<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true"
    tools:context=".LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_large" />

            <TextView
                style="@style/Text.Wordmark.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wordmark" />
        </LinearLayout>

        <!-- Sign in card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_large"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Text.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title" />

            <TextView
                style="@style/Text.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_subtitle" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/username"
                android:text="@string/field_username" />

            <EditText
                android:id="@+id/username"
                style="@style/Widget.Rhythmia.Input"
                android:background="@drawable/bg_input_rect"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:autofillHints="username"
                android:hint="@string/hint_username"
                android:inputType="text" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/password"
                android:text="@string/field_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/password"
                    style="@style/Widget.Rhythmia.Input"
                    android:background="@drawable/bg_input_rect"
                    android:layout_height="48dp"
                    android:autofillHints="password"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingEnd="56dp" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/show_password"
                    android:scaleType="center"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_button"
                style="@style/Widget.Rhythmia.Button"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="48dp"
                android:text="@string/login_button"
                app:cornerRadius="4dp" />
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_footer_prompt" />

            <TextView
                android:id="@+id/create_account_link"
                style="@style/Text.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/geist_semibold"
                android:padding="4dp"
                android:text="@string/login_footer_link"
                android:textColor="@color/accent_secondary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
